{
    "name": "vouch/laravel-socialite-example",
    "type": "project",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.1",
        "kovah/laravel-socialite-oidc": "^0.8",
        "laravel/framework": "^13.23",
        "laravel/socialite": "^5.29",
        "socialiteproviders/manager": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "minimum-stability": "stable"
}
